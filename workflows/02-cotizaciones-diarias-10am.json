    {
      "parameters": {
        "jsCode": "// Obtener cotizaciones\nconst cotizaciones = $('Consultar Cotizaciones').all();\nconst contactos = $('Obtener Contactos Activos').all();\n\n// Fecha actual argentina\nconst ahora = new Date();\nconst opciones = {\n  weekday: 'long',\n  day: 'numeric',\n  month: 'long',\n  year: 'numeric',\n  timeZone: 'America/Argentina/Buenos_Aires'\n};\nconst fecha = ahora.toLocaleDateString('es-AR', opciones);\nconst hora = ahora.toLocaleTimeString('es-AR', {\n  hour: '2-digit',\n  minute: '2-digit',\n  timeZone: 'America/Argentina/Buenos_Aires'\n});\n\n// Emojis que SÍ funcionan en WhatsApp API\nconst emojiMap = {\n  'USD': '💵',\n  'EUR': '💶', \n  'BTC': '🟠',  // Cambié el símbolo Bitcoin por círculo naranja\n  'USDT': '🟢', // Círculo verde\n  'ETH': '🔷'   // Diamante azul\n};\n\n// Construir mensaje\nlet mensaje = `📊 *COTIZACIONES DEL DIA*\\n`;\nmensaje += `━━━━━━━━━━━━━━━━━━\\n`;\nmensaje += `📅 ${fecha.charAt(0).toUpperCase() + fecha.slice(1)}\\n`;\nmensaje += `🕐 ${hora} hs\\n\\n`;\n\n// Agregar cada divisa\nfor (const item of cotizaciones) {\n  const cot = item.json;\n  const emoji = emojiMap[cot.divisa] || '💰';\n  \n  mensaje += `${emoji} *${cot.divisa}*\\n`;\n  mensaje += `   📈 Venta: $${Number(cot.precio_venta).toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}\\n`;\n  mensaje += `   📉 Compra: $${Number(cot.precio_compra).toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}\\n\\n`;\n}\n\nmensaje += `━━━━━━━━━━━━━━━━━━\\n`;\nmensaje += `💬 ¿Querés hacer alguna operación?\\n`;\nmensaje += `¡Escribime y te ayudo!`;\n\n// Crear un item por cada contacto con el mensaje\nconst resultado = contactos.map(contacto => ({\n  json: {\n    chat_id: contacto.json.chat_id,\n    nombre: contacto.json.nombre,\n    mensaje: mensaje,\n    fecha_envio: ahora.toISOString()\n  }\n}));\n\nreturn resultado;"
      },
