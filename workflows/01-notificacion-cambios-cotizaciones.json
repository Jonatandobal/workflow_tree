    {
      "parameters": {
        "jsCode": "const cambios = $('Verificar Cambios Pendientes').all();\nconst cotizaciones = $('Obtener Cotizaciones Actuales').all();\nconst contactos = $('Obtener Contactos').all();\n\n// Fecha y hora actual\nconst ahora = new Date();\nconst hora = ahora.toLocaleTimeString('es-AR', {\n  hour: '2-digit',\n  minute: '2-digit',\n  timeZone: 'America/Argentina/Buenos_Aires'\n});\n\n// Emojis\nconst emojiMap = {\n  'USD': '💵',\n  'EUR': '💶',\n  'BTC': '🟠',\n  'USDT': '🟢',\n  'ETH': '🔷',\n  'REAL': '🇧🇷',\n  'ARS': '🇦🇷'\n};\n\n// Construir mensaje de actualización\nlet mensaje = `🔔 *ACTUALIZACION DE COTIZACIONES*\\n`;\nmensaje += `━━━━━━━━━━━━━━━━━━\\n`;\nmensaje += `🕐 ${hora} hs\\n\\n`;\n\n// Mostrar divisas que cambiaron\nmensaje += `📊 *Cambios detectados:*\\n\\n`;\nfor (const cambio of cambios) {\n  const c = cambio.json;\n  const emoji = emojiMap[c.divisa] || '💰';\n  \n  mensaje += `${emoji} *${c.divisa}*\\n`;\n  \n  // Mostrar cambio en precio de venta\n  if (c.precio_venta_anterior !== c.precio_venta_nuevo) {\n    const diff = c.precio_venta_nuevo - c.precio_venta_anterior;\n    const icono = diff > 0 ? '📈' : '📉';\n    mensaje += `   Venta: $${Number(c.precio_venta_anterior).toFixed(2)} → $${Number(c.precio_venta_nuevo).toFixed(2)} ${icono}\\n`;\n  }\n  \n  // Mostrar cambio en precio de compra\n  if (c.precio_compra_anterior !== c.precio_compra_nuevo) {\n    const diff = c.precio_compra_nuevo - c.precio_compra_anterior;\n    const icono = diff > 0 ? '📈' : '📉';\n    mensaje += `   Compra: $${Number(c.precio_compra_anterior).toFixed(2)} → $${Number(c.precio_compra_nuevo).toFixed(2)} ${icono}\\n`;\n  }\n  \n  mensaje += `\\n`;\n}\n\nmensaje += `━━━━━━━━━━━━━━━━━━\\n`;\nmensaje += `📋 *Cotizaciones actuales:*\\n\\n`;\n\n// Mostrar todas las cotizaciones actuales\nfor (const item of cotizaciones) {\n  const cot = item.json;\n  const emoji = emojiMap[cot.divisa] || '💰';\n  \n  mensaje += `${emoji} *${cot.divisa}*\\n`;\n  mensaje += `   📈 Venta: $${Number(cot.precio_venta).toFixed(2)}\\n`;\n  mensaje += `   📉 Compra: $${Number(cot.precio_compra).toFixed(2)}\\n\\n`;\n}\n\nmensaje += `━━━━━━━━━━━━━━━━━━\\n`;\nmensaje += `💬 ¿Querés hacer alguna operación?`;\n\n// Crear items para cada contacto\nconst resultado = contactos.map(contacto => ({\n  json: {\n    chat_id: contacto.json.chat_id,\n    nombre: contacto.json.nombre,\n    mensaje: mensaje,\n    cambios_ids: cambios.map(c => c.json.id)\n  }\n}));\n\nreturn resultado;"
      },
